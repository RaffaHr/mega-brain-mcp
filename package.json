{
  "name": "@raffahr/mega-brain-mcp",
  "version": "0.1.6",
  "description": "Evidence-aware MCP orchestration for AgentMemory, Code Review Graph, and Git",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agentmemory",
    "code-review-graph",
    "codex",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaffaHr/mega-brain-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/RaffaHr/mega-brain-mcp/issues"
  },
  "homepage": "https://github.com/RaffaHr/mega-brain-mcp#readme",
  "bin": {
    "mega-brain": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "compatibility",
    "docs",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:spec": "vitest run --pool=threads --maxWorkers=1 --reporter=json --outputFile=.spec/verification/vitest-results.json",
    "test:autonomous": "vitest run tests/e2e/autonomous-lifecycle.test.ts tests/e2e/concurrent-projects.test.ts",
    "benchmark": "vitest run tests/e2e/benchmark.test.ts",
    "audit": "node scripts/onp-spec-ci.mjs audit --ci",
    "prepack": "npm run build",
    "test:isolated": "node scripts/test-isolated-lifecycle.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.6.0",
    "@modelcontextprotocol/sdk": "1.26.0",
    "better-sqlite3": "12.4.1",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "mcp-use": "1.34.6",
    "picocolors": "^1.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "hono": "4.13.4",
    "posthog-js": "1.418.15"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
