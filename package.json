{
  "name": "@raffahr/mega-brain-mcp",
  "version": "0.1.0",
  "description": "Evidence-aware MCP orchestration for AgentMemory, Code Review Graph, and Git",
  "type": "module",
  "bin": {
    "mega-brain": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "compatibility",
    "docs",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:spec": "vitest run --reporter=json --outputFile=.spec/verification/vitest-results.json",
    "benchmark": "vitest run tests/e2e/benchmark.test.ts",
    "audit": "node scripts/onp-spec-ci.mjs audit --ci"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "better-sqlite3": "12.4.1",
    "mcp-use": "1.34.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "hono": "4.13.4",
    "posthog-js": "1.418.15"
  },
  "license": "Apache-2.0"
}
