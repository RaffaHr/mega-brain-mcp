{
  "name": "mega-brain-mcp",
  "version": "0.1.0",
  "description": "Evidence-aware MCP orchestration for AgentMemory, Code Review Graph, and Git",
  "type": "module",
  "engines": {
    "node": "^20.20.0 || >=22.22.0"
  },
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:spec": "vitest run --reporter=json --outputFile=.spec/verification/vitest-results.json",
    "audit": "onp-spec audit --ci"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "mcp-use": "1.34.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "license": "MIT"
}
