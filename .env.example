# Mega Brain runtime
MEGA_BRAIN_DATA_DIR=.mega-brain
MEGA_BRAIN_PORT=3000
MEGA_BRAIN_ALLOW_EGRESS=false
MEGA_BRAIN_ALLOW_LLM=false

# AgentMemory profile: managed (default) or remote
MEGA_BRAIN_AGENTMEMORY_MODE=managed
MEGA_BRAIN_AGENTMEMORY_URL=http://127.0.0.1:3111
# Remote mode setup stores the real token in .mega-brain/config.json for this repository.
MEGA_BRAIN_AGENTMEMORY_TOKEN=
MEGA_BRAIN_AGENTMEMORY_REST_PORT=3111
MEGA_BRAIN_AGENTMEMORY_STREAMS_PORT=3112
MEGA_BRAIN_AGENTMEMORY_VIEWER_PORT=3113
MEGA_BRAIN_AGENTMEMORY_ENGINE_PORT=3114

# Managed AgentMemory only. Direct variables override this advanced JSON map.
MEGA_BRAIN_AGENTMEMORY_ENV_JSON={}

# Managed dependency versions. Leave empty to use Mega Brain's bundled defaults.
MEGA_BRAIN_AGENTMEMORY_VERSION="0.9.29"
MEGA_BRAIN_CODE_REVIEW_GRAPH_VERSION="2.3.7"
MEGA_BRAIN_III_ENGINE_VERSION="0.11.2"
AGENTMEMORY_SECRET=
AGENTMEMORY_TOOLS=all

# ── AgentMemory LLM providers (managed mode) ────────────────────────
# LLM Provider choice: anthropic, openai, gemini, openrouter, minimax, ollama
# Compression, summarization, reflection, and graph extraction require an LLM key.
# Enabling any external provider requires MEGA_BRAIN_ALLOW_EGRESS=true and MEGA_BRAIN_ALLOW_LLM=true.
# Docs: https://www.agent-memory.dev/docs/configuration#llm-provider
AGENTMEMORY_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
MINIMAX_API_KEY=
OLLAMA_HOST=

# ── AgentMemory Embedding providers (managed mode) ──────────────────
# Embedding provider: local (default fastembed all-MiniLM-L6-v2), openai, voyage, cohere, gemini, ollama
# Docs: https://www.agent-memory.dev/docs/configuration#embedding-provider
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=
COHERE_API_KEY=

# ── AgentMemory behavior flags (managed mode) ───────────────────────
# Docs: https://www.agent-memory.dev/docs/configuration#behavior-flags

# Knowledge graph extraction – extracts entities and relations from
# observations into a knowledge graph (requires LLM provider).
GRAPH_EXTRACTION_ENABLED=false

# Memory consolidation – periodically summarizes sessions into
# semantic facts and procedures (requires LLM provider).
CONSOLIDATION_ENABLED=false

# LLM-powered observation compression – every observation is
# compressed by the LLM for richer summaries (costs tokens).
# OFF uses zero-LLM synthetic compression (requires LLM provider).
AGENTMEMORY_AUTO_COMPRESS=false

# In-conversation context injection – hooks write recalled context
# into the coding agent conversation. OFF captures in background
# without injecting (works without LLM key).
AGENTMEMORY_INJECT_CONTEXT=false

# Background reflection – post-session synthesis of new patterns (requires LLM provider).
AGENTMEMORY_REFLECT=false

# Session snapshots – capture periodic memory state snapshots.
SNAPSHOT_ENABLED=false

# ── AgentMemory Search Tuning (managed mode) ────────────────────────
# Docs: https://www.agent-memory.dev/docs/configuration#search-tuning
# Search graph weight (0.0 to 1.0, default 0.3)
AGENTMEMORY_GRAPH_WEIGHT=0.3
# Drop stale vector indices on startup/schema change
AGENTMEMORY_DROP_STALE_INDEX=false
# Multimodal image embeddings
AGENTMEMORY_IMAGE_EMBEDDINGS=false

# ── AgentMemory CLI & Runtime Knobs (managed mode) ──────────────────
# Docs: https://www.agent-memory.dev/docs/configuration#cli-and-runtime-knobs
AGENTMEMORY_DEBUG=false
AGENTMEMORY_VERBOSE=false
AGENTMEMORY_PROJECT_NAME=
AGENTMEMORY_AGENT_SCOPE=

# ── AgentMemory Editor Bridges (managed mode) ───────────────────────
# Docs: https://www.agent-memory.dev/docs/configuration#bridges
AGENTMEMORY_CLAUDE_CODE_BRIDGE=false
AGENTMEMORY_CURSOR_BRIDGE=false
AGENTMEMORY_WINDSURF_BRIDGE=false
AGENTMEMORY_CLINE_BRIDGE=false

# Code Review Graph
MEGA_BRAIN_CRG_COMMAND=code-review-graph
MEGA_BRAIN_CRG_ARGS_JSON=["serve"]
MEGA_BRAIN_CRG_DATA_DIR=.mega-brain/crg
MEGA_BRAIN_CRG_ENV_JSON={}
# ── Code Review Graph Embeddings ──────────────────────────────────
# Embedding provider: local (default fastembed all-MiniLM-L6-v2), openai, voyage, google, minimax
# Docs: https://github.com/tirth8205/code-review-graph#environment-variables
CRG_EMBEDDING_MODEL=all-MiniLM-L6-v2
CRG_OPENAI_API_KEY=
CRG_OPENAI_BASE_URL=
CRG_OPENAI_MODEL=text-embedding-3-small
CRG_VOYAGE_API_KEY=
CRG_VOYAGE_MODEL=voyage-code-3
CRG_GOOGLE_API_KEY=
CRG_MINIMAX_API_KEY=

