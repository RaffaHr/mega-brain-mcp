MEGA_BRAIN_DATA_DIR=.mega-brain
MEGA_BRAIN_PORT=3000
MEGA_BRAIN_AGENTMEMORY_URL=http://127.0.0.1:3111
MEGA_BRAIN_AGENTMEMORY_TOKEN=
MEGA_BRAIN_AGENTMEMORY_ENV_JSON={"EMBEDDING_PROVIDER":"local"}
MEGA_BRAIN_CRG_COMMAND=code-review-graph
MEGA_BRAIN_CRG_ARGS_JSON=["serve"]
MEGA_BRAIN_CRG_ENV_JSON={"CRG_EMBEDDINGS":"local"}
MEGA_BRAIN_ALLOW_EGRESS=false
MEGA_BRAIN_ALLOW_LLM=false

# AgentMemory enviroments variables
III_VERSION=0.11.2
III_SDK_VERSION=0.11.2

AGENTMEMORY_SECRET=
AGENTMEMORY_TOOLS=all
AGENTMEMORY_AUTO_COMPRESS=false
AGENTMEMORY_INJECT_CONTEXT=true

# Opcional para embeddings remotos:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=
AGENTMEMORY_AUTO_COMPRESS=true

GRAPH_EXTRACTION_ENABLED=true
CONSOLIDATION_ENABLED=true
# Insights de segunda ordem
AGENTMEMORY_REFLECT=true
SNAPSHOT_ENABLED=true